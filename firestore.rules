rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mustChangePassword == false;
    }
    function validText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validDate(value) { return value is string && value.size() <= 40; }
    function ideaFields() {
      return request.resource.data.keys().hasOnly(['id', 'title', 'description', 'category', 'status', 'authorId', 'authorName', 'createdAt', 'updatedAt', 'likes', 'dislikes', 'referenceImages'])
        && request.resource.data.id is string
        && validText(request.resource.data.title, 200)
        && request.resource.data.description is string && request.resource.data.description.size() <= 10000
        && request.resource.data.category in ['Juegos', 'Software', 'Pagina Web', 'Apps', 'Upgrade']
        && request.resource.data.status in ['IDEA', 'VALIDATING', 'APPROVED', 'REJECTED', 'CONVERTED_TO_PROJECT']
        && validText(request.resource.data.authorName, 100)
        && validDate(request.resource.data.createdAt) && validDate(request.resource.data.updatedAt)
        && request.resource.data.likes is int && request.resource.data.dislikes is int
        && request.resource.data.likes >= 0 && request.resource.data.dislikes >= 0
        && request.resource.data.get('referenceImages', []) is list
        && request.resource.data.get('referenceImages', []).size() <= 3;
    }
    function projectFields() {
      return request.resource.data.keys().hasOnly(['id', 'name', 'description', 'status', 'priority', 'ownerId', 'ownerName', 'members', 'sourceIdeaId', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.name, 200)
        && request.resource.data.description is string && request.resource.data.description.size() <= 10000
        && request.resource.data.status in ['PLANNING', 'IN_PROGRESS', 'TESTING', 'PAUSED', 'COMPLETED']
        && request.resource.data.priority in ['LOW', 'MEDIUM', 'HIGH']
        && validText(request.resource.data.ownerName, 100)
        && request.resource.data.members is list && request.resource.data.members.size() <= 100
        && validDate(request.resource.data.createdAt) && validDate(request.resource.data.updatedAt);
    }
    function taskFields() {
      return request.resource.data.keys().hasOnly(['id', 'title', 'description', 'projectId', 'assignedTo', 'status', 'priority', 'fastTrack', 'completionVotes', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.title, 200)
        && request.resource.data.description is string && request.resource.data.description.size() <= 10000
        && request.resource.data.projectId is string && request.resource.data.assignedTo is string
        && request.resource.data.status in ['TODO', 'IN_PROGRESS', 'REVIEW', 'URGENT', 'DONE']
        && request.resource.data.priority in ['LOW', 'MEDIUM', 'HIGH']
        && request.resource.data.fastTrack is bool
        && request.resource.data.completionVotes is map
        && validDate(request.resource.data.createdAt) && validDate(request.resource.data.updatedAt);
    }
    function validVote(ideaId) {
      let before = get(/databases/$(database)/documents/ideas/$(ideaId)).data;
      let after = getAfter(/databases/$(database)/documents/ideas/$(ideaId)).data;
      let votePath = /databases/$(database)/documents/users/$(request.auth.uid)/ideaVotes/$(ideaId);
      let receipt = getAfter(votePath).data;
      let likes = before.get('likes', 0) + (receipt.vote == 'like' ? 1 : 0);
      let dislikes = before.get('dislikes', 0) + (receipt.vote == 'dislike' ? 1 : 0);
      return active() && before.authorId != request.auth.uid
        && before.status in ['IDEA', 'VALIDATING'] && !exists(votePath)
        && receipt.keys().hasOnly(['vote']) && receipt.vote in ['like', 'dislike']
        && after.diff(before).affectedKeys().hasOnly(['likes', 'dislikes', 'status', 'updatedAt'])
        && after.likes == likes && after.dislikes == dislikes
        && after.status == (likes >= 2 ? 'APPROVED' : dislikes >= 2 ? 'REJECTED' : before.status);
    }
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || active();
      allow create, update, delete: if false;
      match /ideaVotes/{ideaId} {
        allow read: if active() && request.auth.uid == userId;
        allow create: if active() && request.auth.uid == userId && validVote(ideaId);
        allow update, delete: if false;
      }
    }
    match /ideas/{ideaId} {
      allow read: if active();
      allow create: if active() && ideaFields()
        && request.resource.data.id == ideaId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'IDEA'
        && request.resource.data.likes == 0 && request.resource.data.dislikes == 0;
      allow update: if active() && ideaFields() && request.resource.data.id == ideaId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && (validVote(ideaId) || (
          request.resource.data.likes == resource.data.likes
          && request.resource.data.dislikes == resource.data.dislikes
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'APPROVED' && request.resource.data.status == 'CONVERTED_TO_PROJECT'))
        ));
      allow delete: if active();
    }
    match /projects/{projectId} {
      allow read: if active();
      allow create: if active() && projectFields()
        && request.resource.data.id == projectId && request.resource.data.ownerId == request.auth.uid;
      allow update: if active() && projectFields() && request.resource.data.id == projectId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if active();
    }
    match /tasks/{taskId} {
      allow read: if active();
      allow create: if active() && taskFields() && request.resource.data.id == taskId
        && request.resource.data.createdAt == request.resource.data.updatedAt
        && request.resource.data.completionVotes.size() == 0;
      allow update: if active() && taskFields() && request.resource.data.id == taskId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.completionVotes.diff(resource.data.completionVotes).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.completionVotes == resource.data.completionVotes
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completionVotes', 'updatedAt'])
            && request.resource.data.completionVotes[request.auth.uid] in ['SUCCESS', 'NEEDS_WORK']));
      allow delete: if active();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
